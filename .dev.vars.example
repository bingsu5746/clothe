# 로컬 개발용. 이 파일을 .dev.vars 로 복사해서 값 채우기 (커밋 금지)
APP_PIN=1234
SESSION_SECRET=change-me-to-a-long-random-string
SHORTCUT_TOKEN=change-me-too
GEMINI_API_KEY=

# ── 아래는 선택 (없어도 앱은 동작) ──
# 네이버 쇼핑 검색 API (https://developers.naver.com → 애플리케이션 등록 → '검색' API 사용 설정). 없으면 쇼핑몰 검색 링크만 제공.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 가상 피팅 (유료). Replicate 토큰을 넣으면 IDM-VTON으로 켜짐. 없으면 가상 피팅은 꺼지고 2D 콜라주만.
REPLICATE_API_TOKEN=
# Gemini 이미지 모델로 가상 피팅을 하려면 TRYON_PROVIDER=gemini (GEMINI_API_KEY가 결제 연결된 키여야 함)
# TRYON_PROVIDER=
# TRYON_MODEL=
